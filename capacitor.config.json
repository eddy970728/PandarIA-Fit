{
  "appId": "com.pandaria.fit",
  "appName": "PandarIA Fit",
  "webDir": "www",
  "android": {
    "backgroundColor": "#12151a",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#12151a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_pandaria",
      "iconColor": "#ff7a1a"
    }
  }
}
